
URL:=mihxil/mihxil-demo:latest
VERSION:=$(shell mvn help:evaluate -Dexpression=project.version -q -DforceStdout)
CP:=$(shell mvn dependency:build-classpath -DincludeScope=compile -Dmdep.outputFile=/dev/stdout -q)

JARS_DIR:=resources/jars
JARS_STAGE:=target/jars
JARS_JS:=resources/js/jars.js

EXPR:=3 * sin (pi / 4)


help:     ## Show this help.
	@sed -n 's/^##//p' $(MAKEFILE_LIST)
	@grep -E '^[/%a-zA-Z0-9._-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'

target/mihxil-demo-$(VERSION).jar:
	(cd ../mihxil-configuration/ ; mvn  install ) ; (cd ../mihxil-math/ ; mvn install ) ; mvn

jars: target/mihxil-demo-$(VERSION).jar  ## update the jars in resources/jars (the cheerpj classpath), and regenerate $(JARS_JS)
	rm -rf $(JARS_STAGE)
	mvn -q dependency:copy-dependencies -DincludeScope=runtime -DoutputDirectory=$(CURDIR)/$(JARS_STAGE)
	cp target/original-mihxil-demo-$(VERSION).jar $(JARS_STAGE)/
	mkdir -p $(JARS_DIR)
	rm -f $(JARS_DIR)/*.jar
	cp $(JARS_STAGE)/*.jar $(JARS_DIR)/
	@{ \
	  echo "// Generated by 'make jars'. Do not edit."; \
	  echo "// The cheerpj classpath, as present in $(JARS_DIR)."; \
	  echo "export const JARS = ["; \
	  for jar in $(JARS_DIR)/*.jar; do echo "    \"$$(basename $$jar)\","; done; \
	  echo "];"; \
	} > $(JARS_JS)
	@echo "Wrote $(JARS_JS):" ; sed -n 's/^    /  /p' $(JARS_JS)

docker: Dockerfile
	docker build -t $(URL) --build-arg VERSION=$(VERSION) .

localrun: target/mihxil-demo-$(VERSION).jar
	java -jar $< prefs


runro:
	docker run -v $(HOME):/root:ro -it  $(URL) prefs

dockerrun:
	docker run -v $(HOME):/root -it  $(URL)

runprefs:
	docker run -v $(HOME):/root -it  $(URL) prefs mm

explore:
	docker run  -$(HOME):/root:ro -it --entrypoint /bin/bash $(URL)

run: index.html  ## run with cheerpj
	npx serve -l 3000

sass/%.css:

resources/css/%.css: sass/%.scss  ## run sass
	sass $< $@

sasswatch: ## start sass  --watch
	sass --watch sass/:resources/css/

quickstart:  ## make
	@java -cp $(CP) src/quickstart/QuickStartDateParser.java
	@java -cp $(CP) src/quickstart/QuickStartQuaternions.java
	@java -cp $(CP) src/quickstart/QuickStartWindowed.java



index.html: README-source.adoc README-source-docinfo.html Makefile resources/css/demo-standalone.css resources/css/demo-standalone-mobile.css resources/css/demo.css  resources/css/calculator.css DEMO-*.adoc    ## create index.html from README-source.adoc
	asciidoctor $< -a htmled=true -a docs=. -o $@
	#asciidoctor --trace -r asciidoctor-multipage -b multipage_html5   -D pages $<


test_big:  ## test real
	java -cp target/mihxil-demo-$(VERSION).jar org.meeuw.math.demo.Calculator "$(EXPR)" bigdecimal

test_rational:
	java -cp target/mihxil-demo-$(VERSION).jar org.meeuw.math.demo.Calculator "$(EXPR)" rational

test_complex:
	java -cp target/mihxil-demo-$(VERSION).jar org.meeuw.math.demo.Calculator "$(EXPR)" complex

test_bigcomplex:
	java -cp target/mihxil-demo-$(VERSION).jar org.meeuw.math.demo.Calculator "$(EXPR)" bigcomplex


test_real:  ## test real
	java -cp target/mihxil-demo-$(VERSION).jar org.meeuw.math.demo.Calculator "$(EXPR)" real

test_gaussian:
	java -cp target/mihxil-demo-$(VERSION).jar org.meeuw.math.demo.Calculator "$(EXPR)" gaussian

test_solver:
	java -cp target/mihxil-demo-$(VERSION).jar org.meeuw.math.demo.Solver 24 8 8 4 4

test: test_big test_rational test_complex test_real
